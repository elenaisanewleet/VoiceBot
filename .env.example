# ── Обязательное ────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Публичный HTTPS-адрес, на котором открыт этот сервер.
# Telegram открывает Mini App только по HTTPS, и микрофон в браузере
# тоже работает только по HTTPS. Локально можно поднять туннель:
#   npx localtunnel --port 8080   /   cloudflared tunnel --url http://localhost:8080
PUBLIC_URL=https://example.com

# Ключ для распознавания речи (OpenAI-совместимый endpoint).
# Проще всего не заполнять руками, а выполнить: npm run setup
STT_API_KEY=

# ── Необязательное ──────────────────────────────────────────────────────────
PORT=8080

# Куда ходить за распознаванием. Годится любой OpenAI-совместимый endpoint,
# включая свой whisper.cpp на localhost.
#
#   Groq   — бесплатный тариф, карта при регистрации не нужна:
#            STT_BASE_URL=https://api.groq.com/openai/v1
#            STT_MODEL=whisper-large-v3-turbo
#   OpenAI — платно:
#            STT_BASE_URL=https://api.openai.com/v1
#            STT_MODEL=gpt-4o-mini-transcribe
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo

# Язык распознавания по умолчанию (ISO-639-1). Пусто = автоопределение.
DEFAULT_LANG=ru

# Модель, которая превращает сырую расшифровку в грамотный текст:
# пунктуация, заглавные буквы, без «э-э», повторов и оговорок.
# Ключ и адрес по умолчанию берутся те же, что у распознавания.
#   Groq:   LLM_MODEL=openai/gpt-oss-120b
#   OpenAI: LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=openai/gpt-oss-120b

# Стиль по умолчанию: raw (как сказано) | clean (грамотно) | formal (по-деловому)
DEFAULT_STYLE=clean

# Если true — бот работает через webhook, иначе через long polling.
# Webhook вешается на PUBLIC_URL/webhook/<секрет>. На хостинге нужен true.
USE_WEBHOOK=false

# Бесплатные хостинги усыпляют сервис после нескольких минут тишины, и первый
# запрос потом ждёт около минуты. С KEEPALIVE=true сервис будит себя сам.
# Локально не нужно.
KEEPALIVE=false
KEEPALIVE_MINUTES=10

# Секрет для пути вебхука. Если не задан — генерируется из BOT_TOKEN.
WEBHOOK_SECRET=

# Максимальный размер куска аудио, байт (защита от мусора)
MAX_AUDIO_BYTES=20971520
